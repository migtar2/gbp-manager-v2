# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth Redirect URI (must match Google Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:3456/callback

# Port for the auth server
AUTH_PORT=3456

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Anti-repetition settings
MAX_SIMILARITY_THRESHOLD=0.45
MAX_GENERATION_ATTEMPTS=5

# MCP write tools (fail closed: solo 'true' las activa)
GBP_ENABLE_WRITE_TOOLS=false

# LLM para el motor híbrido de respuestas (opcional; sin esto se usan solo reglas)
# Cualquier endpoint compatible con el API de chat de OpenAI (OpenAI, vLLM, Ollama...)
REPLY_LLM_BASE_URL=
REPLY_LLM_API_KEY=
REPLY_LLM_MODEL=
